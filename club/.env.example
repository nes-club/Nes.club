# -----------------------------------------------------------------------
# Минимальный набор для локального запуска через docker compose:
# скопируй в club/.env и заполни SECRET_KEY
# -----------------------------------------------------------------------

# Core
SECRET_KEY="salt_for_cookies"
MODE=dev
DEBUG=true
APP_HOST=http://127.0.0.1:8000
APP_NAME=Сообщество выпускников РЭШ
APP_TITLE=Сообщество выпускников РЭШ

# Database (в docker compose уже прописаны эти значения по умолчанию)
POSTGRES_DB=nes_club
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=  # нужен только если Redis требует аутентификации (например Railway)

# Email
# Локальная разработка: письма выводятся в консоль, ничего настраивать не нужно
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Продакшн через Brevo HTTP API (рекомендуется — Railway блокирует исходящий SMTP):
# EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
# BREVO_API_KEY=<ключ из Brevo → My account → SMTP & API → API Keys>
# Продакшн через SMTP (только если провайдер не блокирует порты):
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=xxxx@smtp-brevo.com
# EMAIL_HOST_PASSWORD=<smtp ключ>
DEFAULT_FROM_EMAIL=Сообщество выпускников РЭШ <no-reply@nes.ru>

# Telegram (опционально — боты не стартуют без токенов, но веб-приложение работает)
TELEGRAM_TOKEN=
# URL бота для кнопки «Привязать бота» в профиле (формат: https://t.me/имя_бота)
TELEGRAM_BOT_URL=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CLUB_CHANNEL_URL=
TELEGRAM_CLUB_CHANNEL_ID=
TELEGRAM_CLUB_CHAT_URL=
TELEGRAM_CLUB_CHAT_ID=
TELEGRAM_ONLINE_CHANNEL_URL=
TELEGRAM_ONLINE_CHANNEL_ID=

# Webhook-настройки бота (только для продакшна, не нужны в dev/polling-режиме)
# TELEGRAM_BOT_WEBHOOK_HOST_URL=https://<bot-service>.railway.app
# TELEGRAM_HELPDESK_WEBHOOK_HOST_URL=https://<helpdeskbot-service>.railway.app

TELEGRAM_HELP_DESK_BOT_TOKEN=
TELEGRAM_HELP_DESK_BOT_QUESTION_CHANNEL_ID=
TELEGRAM_HELP_DESK_BOT_QUESTION_CHANNEL_DISCUSSION_ID=

# Медиа (опционально — без этого аватарки не загружаются, но приложение не падает)
# Подробнее: docs/media-storage.md
MEDIA_UPLOAD_URL=
MEDIA_UPLOAD_CODE=

# OG-превью (опционально)
OG_IMAGE_GENERATOR_URL=

# Мониторинг (опционально)
SENTRY_DSN=
