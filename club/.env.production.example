# =============================================================================
# Production env template for Railway (HTTP-API email via Resend).
# Copy values into Railway → each service → Variables → Raw Editor.
#
# Architecture: 4 services from the SAME repo, told apart by SERVICE_CMD
# (start.sh runs `make $SERVICE_CMD`). Add Postgres + Redis as Railway plugins.
#
#   Service        SERVICE_CMD               Needs
#   -----------    ----------------------    -------------------------------------
#   club_app       docker-run-production     core + db + redis + email + telegram
#   queue          docker-run-queue          core + db + redis + email + telegram
#   bot      (opt) docker-run-bot            core + db + redis + telegram + bot webhook
#   helpdeskbot(opt) docker-run-helpdeskbot  core + db + redis + helpdesk vars
#
# Minimal site (no bots): sections 1–3 on club_app and queue.
# =============================================================================

# --- per service: pick ONE ---------------------------------------------------
SERVICE_CMD=docker-run-production

# --- 1. Core -----------------------------------------------------------------
MODE=production
DEBUG=false
# generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
APP_HOST=https://your-app.up.railway.app
APP_NAME=Сообщество выпускников РЭШ
APP_TITLE=Сообщество выпускников РЭШ

# --- 2. Database + Redis (Railway reference variables from the plugins) -------
POSTGRES_HOST=${{Postgres.PGHOST}}
POSTGRES_PORT=${{Postgres.PGPORT}}
POSTGRES_DB=${{Postgres.PGDATABASE}}
POSTGRES_USER=${{Postgres.PGUSER}}
POSTGRES_PASSWORD=${{Postgres.PGPASSWORD}}

REDIS_HOST=${{Redis.REDISHOST}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
REDIS_DB=0

# --- 3. Email — Resend (club_app + queue) ------------------------------------
# Railway blocks outbound SMTP, so email goes over an HTTP API via django-anymail.
# ⚠️ Verify the domain in Resend → Domains (SPF/DKIM); DEFAULT_FROM_EMAIL must use it,
#    otherwise login codes never arrive. Alternative provider: Brevo (see below).
EMAIL_BACKEND=anymail.backends.resend.EmailBackend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Сообщество выпускников РЭШ <no-reply@yourdomain.com>
# Brevo alternative:
# EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
# BREVO_API_KEY=

# --- 4. Telegram — main bot (club_app + queue + bot) -------------------------
# Optional: without a token the bots don't start, but the web app works.
TELEGRAM_TOKEN=
TELEGRAM_BOT_URL=https://t.me/your_bot
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CLUB_CHANNEL_ID=
TELEGRAM_CLUB_CHANNEL_URL=
TELEGRAM_CLUB_CHAT_ID=
TELEGRAM_CLUB_CHAT_URL=
TELEGRAM_ONLINE_CHANNEL_ID=
TELEGRAM_ONLINE_CHANNEL_URL=
# Only on the `bot` service (webhook mode in prod — needs a public HTTPS URL):
TELEGRAM_BOT_WEBHOOK_HOST_URL=https://your-bot-service.up.railway.app

# --- 5. Helpdesk bot (only the `helpdeskbot` service) ------------------------
TELEGRAM_HELP_DESK_BOT_TOKEN=
TELEGRAM_HELP_DESK_BOT_QUESTION_CHANNEL_ID=
TELEGRAM_HELP_DESK_BOT_QUESTION_CHANNEL_DISCUSSION_ID=
TELEGRAM_HELPDESK_WEBHOOK_HOST_URL=https://your-helpdeskbot-service.up.railway.app

# --- 6. Optional -------------------------------------------------------------
MEDIA_UPLOAD_URL=          # avatar/image uploads (app doesn't crash without it)
MEDIA_UPLOAD_CODE=
OG_IMAGE_GENERATOR_URL=    # OG preview images for posts
SENTRY_DSN=                # error monitoring
WEBHOOK_SECRETS=           # comma-separated secrets for inbound /webhooks/ (optional)

# --- 7. First admin (temporary — set on club_app, redeploy, then DELETE) -----
# create_admin runs on startup, is idempotent. Then log in via /auth/login/.
# INITIAL_ADMIN_EMAIL=you@email.com
# INITIAL_ADMIN_SLUG=admin
# INITIAL_ADMIN_NAME=Your Name
